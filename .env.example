# Copy to .env; do not commit credentials.
KB_DATA_DIR=data
KB_MODE=improved
# sentence-transformers is semantic; hash is an offline smoke-test backend only.
KB_EMBEDDING_BACKEND=sentence-transformers
KB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Keep model downloads inside the project (absolute paths also accepted).
HF_HOME=models/huggingface
KB_INDEX_VARIANTS=both
KB_ANSWER_BACKEND=opencode
OPENCODE_API_KEY=
# Default follows the supplied official notebook. Override for your organizer gateway.
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_MODEL=deepseek-v4.1-flash
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Set actual provider prices in USD per million tokens; blank means unknown.
KB_EMBEDDING_PRICE=
KB_LLM_INPUT_PRICE=
KB_LLM_OUTPUT_PRICE=
