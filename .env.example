# Copy to .env; do not commit credentials.
KB_DATA_DIR=data
# sentence-transformers is semantic; hash is an offline smoke-test backend only.
KB_EMBEDDING_BACKEND=sentence-transformers
KB_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Keep model downloads inside the project (absolute paths also accepted).
HF_HOME=models/huggingface
# llm: LLM profiling, planning, evidence judging and answers. offline: rules only (diagnostics).
KB_LLM_BACKEND=llm
# paddle: OCR scanned pages with PaddleOCR (pip install -e ".[ocr]"). none: skip scanned pages.
KB_OCR_BACKEND=paddle
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
# Any OpenAI-compatible endpoint. OPENCODE_* names are accepted as fallbacks.
LLM_API_KEY=
# OpenCode (the official evaluator's provider): https://opencode.ai/inference/openai/v1
# Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=https://opencode.ai/inference/openai/v1
# Comma-separated lists rotate calls across models and skip rate-limited ones.
LLM_MODEL=deepseek-v4.1-flash
# Fast non-reasoning model(s) for profiling, planning and judging; defaults to LLM_MODEL. On OpenCode,
# minimax-m2.7 judged ~10x faster than deepseek-v4.1-flash (no hidden reasoning) with similar grades.
LLM_FAST_MODEL=minimax-m2.7
# Sent only to gpt-oss models (low/medium/high).
LLM_REASONING_EFFORT=
# Groq free tier example (about 8k tokens per minute per model), plus the KB_* budgets below:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FAST_MODEL=openai/gpt-oss-20b,qwen/qwen3.8-27b
# LLM_REASONING_EFFORT=low
# KB_MAIN_QUERY_K=25
# KB_ASPECT_QUERY_K=8
# KB_PER_DOCUMENT_K=4
# KB_MAX_CANDIDATES=80
# KB_JUDGE_BATCH=20
# KB_RECOVERY_K=8
# KB_CONTEXT_TOKENS=4500
# KB_MAX_OUTPUT_TOKENS=2500
# KB_LLM_CONCURRENCY=3
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Set actual provider prices in USD per million tokens; blank means unknown.
KB_EMBEDDING_PRICE=
KB_LLM_INPUT_PRICE=
KB_LLM_OUTPUT_PRICE=
